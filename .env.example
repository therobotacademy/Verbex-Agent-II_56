# VERBEX agent — credenciales. Copia este fichero a `.env` y rellena los valores.
# (.env NO se sube a git — es el equivalente de las "Environment Variables" de n8n.)

# --- Claude API (capa cognitiva, verbex/llm.py) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (trigger + notificaciones) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID_PRODUCCION=-1001111111111
TELEGRAM_CHAT_ID_CALIDAD=-1002222222222
# Lista separada por comas de chat_id autorizados a enviar POs (vacío = todos).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Email SMTP (confirmación al cliente, verbex/notify.py) ---
SMTP_FROM=pedidos@verbex.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pedidos@verbex.example
SMTP_PASSWORD=app-password-de-google

# --- Datos (opcional) ---
# Carpeta de los CSV. Por defecto data/ del repo. Equivale a CSV_DATA_DIR de n8n.
# CSV_DATA_DIR=C:/ruta/a/los/csv
